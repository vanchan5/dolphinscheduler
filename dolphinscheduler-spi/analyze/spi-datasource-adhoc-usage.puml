@startuml DolphinScheduler-AdHoc-Connection-Flow

!theme plain
skinparam backgroundColor white
skinparam shadowing false

title 临时连接使用流程（测试连接）

participant "业务代码\n(测试连接)" as Business
participant "DataSourceClientProvider" as Provider
participant "DataSourcePluginManager" as Manager
participant "MySQLDataSourceChannel" as Channel
participant "MySQLAdHocDataSourceClient" as Client
participant "DataSourceProcessorProvider" as ProcessorProvider
participant "MySQLDataSourceProcessor" as Processor
participant "DriverManager" as DriverMgr
participant "MySQL数据库" as DB

Business -> Provider: getAdHocConnection(\n  DbType.MYSQL, connectionParams)
activate Provider

note over Provider
    <b>不使用缓存</b>
    每次都创建新的客户端
    适合测试、低频场景
end note

Provider -> Manager: getDataSourceChannelMap()\n  .get("mysql")
activate Manager
Manager --> Provider: 返回 MySQLDataSourceChannel
deactivate Manager

Provider -> Channel: createAdHocDataSourceClient(\n  params, DbType.MYSQL)
activate Channel

Channel -> Client: new MySQLAdHocDataSourceClient(\n  params, DbType.MYSQL)
activate Client

note over Client
    <b>构造函数</b>
    只保存参数
    不创建连接池
end note

Client --> Channel: 返回客户端实例
deactivate Client

Channel --> Provider: 返回 Client
deactivate Channel

Provider -> Client: getConnection()
activate Client

Client -> ProcessorProvider: getDataSourceProcessor(\n  DbType.MYSQL)
activate ProcessorProvider

ProcessorProvider --> Client: 返回 MySQLDataSourceProcessor
deactivate ProcessorProvider

Client -> Processor: getConnection(connectionParam)
activate Processor

note over Processor
    <b>构建 JDBC URL</b>
    jdbc:mysql://localhost:3306/test_db
    ?useUnicode=true&characterEncoding=UTF-8
    &useSSL=false
end note

Processor -> DriverMgr: DriverManager.getConnection(\n  jdbcUrl, username, password)
activate DriverMgr

note over DriverMgr
    <b>每次都创建新连接</b>
    1. 加载 MySQL Driver
    2. 建立 TCP 连接
    3. MySQL 握手
    4. 认证
end note

DriverMgr -> DB: 建立新连接
activate DB

DB --> DriverMgr: 返回 Connection
deactivate DB

DriverMgr --> Processor: 返回 Connection
deactivate DriverMgr

Processor --> Client: 返回 Connection
deactivate Processor

Client --> Provider: 返回 Connection
deactivate Client

Provider --> Business: 返回 Connection
deactivate Provider

note over Business
    <b>业务代码使用连接</b>
    通常用于测试连接是否可用
    
    try (Connection conn = ...) {
        Statement stmt = conn.createStatement();
        stmt.executeQuery("SELECT 1");
        // 连接测试成功
    }
end note

Business -> Business: conn.close()

note over DB
    <b>连接真正关闭</b>
    释放数据库资源
    下次使用需要重新创建
end note

@enduml

